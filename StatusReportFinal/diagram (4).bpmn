    <bpmn:serviceTask id="ag_ola" name="Apresentar-se e acolher o artista">
      <bpmn:incoming>Flow_0kasytw</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ag_resp" name="Responder dúvidas em linguagem acessível" />
    <bpmn:serviceTask id="ag_op" name="Sugerir oportunidades que cabem no perfil" />
    <bpmn:exclusiveGateway id="g_prod" name="Já tem produtor?" />
    <bpmn:exclusiveGateway id="g_mrg" name="" />
    <bpmn:serviceTask id="ag_proj" name="Criar o projeto no WhatsApp (modelo do produtor)" />
    <bpmn:serviceTask id="ag_estr" name="Estruturar respostas no projeto" />
    <bpmn:userTask id="a_duv" name="Tirar dúvidas (editais, prazos, como funciona)">
      <bpmn:incoming>f_ag_ola_a_duv</bpmn:incoming>
      <bpmn:outgoing>f_a_duv_ag_resp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ag_conn" name="Sugerir e conectar um produtor" />
    <bpmn:userTask id="a_quest" name="Responder perguntas do modelo (áudio/texto)">
      <bpmn:incoming>f_ag_proj_a_quest</bpmn:incoming>
      <bpmn:outgoing>f_a_quest_ag_estr</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_entr" name="Entregar projeto ao produtor">
      <bpmn:incoming>f_ag_estr_a_entr</bpmn:incoming>
      <bpmn:outgoing>f_a_entr_p_recv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="g_par1" name="" />
    <bpmn:parallelGateway id="g_par2" name="" />
    <bpmn:exclusiveGateway id="g_apto" name="Projeto apto?" />
    <bpmn:userTask id="p_recv" name="Receber projeto na carteira">
      <bpmn:incoming>f_a_entr_p_recv</bpmn:incoming>
      <bpmn:outgoing>f_p_recv_p_open</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_open" name="Abrir e gerir o projeto">
      <bpmn:incoming>f_p_recv_p_open</bpmn:incoming>
      <bpmn:incoming>f_g_apto_p_open</bpmn:incoming>
      <bpmn:outgoing>f_p_open_g_par1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_orc" name="Montar / ajustar orçamento">
      <bpmn:incoming>f_g_par1_p_orc</bpmn:incoming>
      <bpmn:outgoing>f_p_orc_g_par2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_eq" name="Montar equipe">
      <bpmn:incoming>f_g_par1_p_eq</bpmn:incoming>
      <bpmn:outgoing>f_p_eq_g_par2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_kan" name="Acompanhar no Kanban (tarefas e prazos)">
      <bpmn:incoming>f_g_par2_p_kan</bpmn:incoming>
      <bpmn:outgoing>f_p_kan_p_val</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_val" name="Validar projeto (bloqueantes e avisos)">
      <bpmn:incoming>f_p_kan_p_val</bpmn:incoming>
      <bpmn:outgoing>f_p_val_g_apto</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_send" name="Inscrever / enviar ao edital">
      <bpmn:incoming>f_g_apto_p_send</bpmn:incoming>
      <bpmn:outgoing>f_p_send_p_conf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_conf" name="Receber confirmação de envio">
      <bpmn:incoming>f_p_send_p_conf</bpmn:incoming>
      <bpmn:outgoing>f_p_conf_ag_notif</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_doc" name="Curadoria documental">
      <bpmn:incoming>f_g_par1_p_doc</bpmn:incoming>
      <bpmn:outgoing>f_p_doc_g_par2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ag_notif" name="Notificar artista (entregue + retorno)">
      <bpmn:incoming>Flow_05z7abf</bpmn:incoming>
      <bpmn:outgoing>Flow_0aj5k2s</bpmn:outgoing>
    </bpmn:serviceTask>
